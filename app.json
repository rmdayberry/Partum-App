{
  "expo": {
    "name": "Partum",
    "slug": "Partum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Riverland.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Riverland.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/64d21b9c-81d0-449e-a972-527a6f5c4e62"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.partum.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.partum.app"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "64d21b9c-81d0-449e-a972-527a6f5c4e62"
      }
    },
    "owner": "rdayberry",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "plugins": [
    "expo-font"
  ]
}
