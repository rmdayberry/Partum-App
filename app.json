{
  "expo": {
    "name": "Partum",
    "slug": "Partum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Riverland.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Riverland.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "assets": ["./node_modules/react-native-vector-icons/Fonts"]
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/64d21b9c-81d0-449e-a972-527a6f5c4e62"
    },
    "assetBundlePatterns": ["**/*", "node_modules/@expo/vector-icons/fonts/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.partum.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.partum.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "webpack"
    },
    "plugins": ["expo-font"],
    "extra": {
      "eas": {
        "projectId": "64d21b9c-81d0-449e-a972-527a6f5c4e62"
      }
    },
    "owner": "rdayberry",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
